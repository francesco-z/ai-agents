# GitLab Cloud (gitlab.com) via official GitLab MCP server endpoint.
# Connects to https://gitlab.com/api/v4/mcp using OAuth 2.0 Dynamic Client
# Registration or PAT.
#
# Copy to ~/.config/gitlab-mcp/<client>.env and chmod 600.

GITLAB_URL=https://gitlab.com

# Auth options:
# 1) Leave GITLAB_PERSONAL_TOKEN empty to use OAuth 2.0 Dynamic Client Registration (browser flow).
# 2) Or provide a scoped Personal Access Token (PAT) with read scopes:
# GITLAB_PERSONAL_TOKEN=

# Tool name prefix (e.g. gitlab_) to avoid collisions when multiple servers are configured
# GITLAB_TOOL_PREFIX=gitlab_

# Runtime: npx (default, requires Node.js 20+) or podman/docker
# GITLAB_MCP_RUNTIME=npx
