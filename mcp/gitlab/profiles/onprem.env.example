# GitLab Self-Managed / On-Prem (tested against GitLab 17.3+ / 18.x / 19.x),
# optionally reached through a SOCKS5 tunnel or VPN.
#
# Note for GitLab 17.3: The native /api/v4/mcp endpoint was introduced in GitLab 18.3+
# and enabled by default in 18.6+. If your 17.3 instance does not have the native endpoint,
# upgrades to 18.6+ will automatically become fully compatible without configuration changes.
#
# Copy to ~/.config/gitlab-mcp/<client>.env and chmod 600.

GITLAB_URL=https://gitlab.internal.acme.example

# Auth options:
# 1) OAuth 2.0 Dynamic Client Registration (DCR) is supported if enabled on the instance.
# 2) Or Personal Access Token (PAT) with read scopes (read_api, read_repository, read_user):
# GITLAB_PERSONAL_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# SOCKS proxy for bastion / VPN access:
# socks5:// is rewritten to socks5h:// by the launcher so DNS resolves inside the tunnel.
# GITLAB_SOCKS_PROXY=socks5://localhost:9999

# Tool name prefix (e.g. gitlab_):
# GITLAB_TOOL_PREFIX=gitlab_

# Runtime: podman (default) or docker / npx
# GITLAB_MCP_RUNTIME=podman
# GITLAB_MCP_IMAGE=docker.io/node:20-alpine
