# One profile per customer / environment. Copy to
# ~/.config/kubernetes-mcp/<profile>.env (chmod 600).

# Kubeconfig file(s), read from the filesystem: colon-separated, each may be a
# glob. Default ~/.kube/config. The launcher merges and flattens them (certs
# embedded) into one kubeconfig in $XDG_RUNTIME_DIR; the originals are only read.
# KUBERNETES_MCP_KUBECONFIG=~/.kube/config
# KUBERNETES_MCP_KUBECONFIG=~/.kube/config-acme-*

# Comma-separated context globs to expose; empty exposes every context.
# KUBERNETES_MCP_CONTEXTS=acme-*

# read-only (default) | non-destructive (adds create/update/run, no deletes or
# exec) | read-write (everything). Restart the client after changing it.
# KUBERNETES_MCP_MODE=read-only

# Secrets are rejected on the Kubernetes client in every mode unless false.
# Helm stores releases as Secrets, so helm_list needs false.
# KUBERNETES_MCP_DENY_SECRETS=true

# ssh -D 9999 -q -N bastion   (or your corporate tunnel)
# Set as proxy-url on every exposed cluster: only API traffic is tunnelled, exec
# auth plugins (aws, gcloud) go direct. Hostnames resolve at the far end, so
# socks5:// and socks5h:// behave the same.
# KUBERNETES_MCP_SOCKS5_PROXY=socks5h://localhost:9999

# Comma-separated toolsets (add helm for helm_list).
# KUBERNETES_MCP_TOOLSETS=core,config

# Runtime: podman (default) | docker | binary | npx. Use binary (the upstream
# release binary on PATH, kubernetes-mcp-server) when contexts use exec auth
# plugins: they and their config (~/.aws, …) do not exist in the container.
# KUBERNETES_MCP_RUNTIME=podman
# KUBERNETES_MCP_BIN=kubernetes-mcp-server
# KUBERNETES_MCP_VERSION=0.1.2
# KUBERNETES_MCP_IMAGE=quay.io/containers/kubernetes_mcp_server:v0.1.2
