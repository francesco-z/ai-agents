# One kubeconfig, any number of contexts: tools take a context argument.
# Copy to ~/.config/kubernetes-mcp/<profile>.env.

# Read from the filesystem, defaults to ~/.kube/config. One file, not a
# colon-separated list. With the container runtimes it must be self-contained
# (embedded certs, no exec auth plugins):
#   kubectl config view --flatten --minify --context X > file
# Use KUBERNETES_MCP_RUNTIME=npx for kubeconfigs with exec plugins.
# KUBERNETES_MCP_KUBECONFIG=~/.kube/config

# read-only (default) | non-destructive (adds create/update/run, no deletes or
# exec) | read-write (everything). Restart the client after changing it.
# KUBERNETES_MCP_MODE=read-only

# Secrets are rejected on the Kubernetes client in every mode unless false.
# KUBERNETES_MCP_DENY_SECRETS=true

# ssh -D 9999 -q -N bastion   (or your corporate tunnel)
# Scoped to the server's traffic; hostnames resolve at the far end of the
# tunnel, so socks5:// and socks5h:// behave the same.
# KUBERNETES_MCP_SOCKS5_PROXY=socks5://localhost:9999
# KUBERNETES_MCP_NO_PROXY=localhost,127.0.0.1,::1

# Comma-separated toolsets.
# KUBERNETES_MCP_TOOLSETS=core,config

# Runtime: podman (default) or docker / npx
# KUBERNETES_MCP_RUNTIME=podman
# KUBERNETES_MCP_VERSION=0.1.2
# KUBERNETES_MCP_IMAGE=quay.io/containers/kubernetes_mcp_server:v0.1.2
