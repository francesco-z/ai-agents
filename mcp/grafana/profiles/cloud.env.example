# Grafana Cloud stack. Copy to ~/.config/grafana-mcp/<client>.env and chmod 600.

GRAFANA_URL=https://acme.grafana.net

# Service account token from the stack (Administration > Users and access >
# Service accounts), Viewer role.
# No quotes on tokens
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_XXXX

# GRAFANA_ORG_ID=1

# Extra flags, space-separated; --disable-write is always forced by the launcher.
# GRAFANA_MCP_EXTRA_ARGS=--disable-admin

# Runtime: podman (default) or docker / uvx
# GRAFANA_MCP_RUNTIME=podman
# MCP_GRAFANA_VERSION=1.3.0
# GRAFANA_MCP_IMAGE=docker.io/grafana/mcp-grafana:1.3.0
