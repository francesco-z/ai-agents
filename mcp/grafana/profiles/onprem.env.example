# Self-hosted Grafana (OSS / Enterprise), optionally reached through a SOCKS5
# tunnel or VPN. Copy to ~/.config/grafana-mcp/<client>.env and chmod 600 — it
# holds the token.

GRAFANA_URL=https://monitoring.internal.acme.example/

# Service account token (Administration > Users and access > Service accounts).
# Give the service account the Viewer role: read-only at the source.
# No quotes on tokens
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_XXXX

# Numeric org ID; omit for the default org (1).
GRAFANA_ORG_ID=7

# ssh -D 9999 -q -N bastion   (or your corporate tunnel)
# Native to mcp-grafana and scoped to its Grafana traffic only; socks5:// and
# socks5h:// both resolve hostnames at the far end of the tunnel.
# GRAFANA_SOCKS5_PROXY=socks5://localhost:9999

# Extra flags, space-separated, e.g. to hide tool categories you do not use.
# --disable-write is always forced by the launcher.
# GRAFANA_MCP_EXTRA_ARGS=--disable-admin --disable-oncall

# Runtime: podman (default) or docker / uvx
# GRAFANA_MCP_RUNTIME=podman
# Pin the server build (supply chain + reproducibility). Empty = latest.
# MCP_GRAFANA_VERSION=
# GRAFANA_MCP_IMAGE=docker.io/grafana/mcp-grafana:latest
