# Confluence/Jira Server or Data Center (tested against Confluence DC 9.2.21),
# reached through a SOCKS5 tunnel. Copy to ~/.config/atlassian-mcp/<client>.env
# and chmod 600 — it holds tokens.

CONFLUENCE_URL=https://confluence.internal.acme.example
JIRA_URL=https://jira.internal.acme.example

# Server/DC auth = Personal Access Token only (no username).
# Create it as a READ-ONLY user: profile menu -> Personal Access Tokens.
CONFLUENCE_PERSONAL_TOKEN=
JIRA_PERSONAL_TOKEN=

# ssh -D 9999 -q -N bastion   (or your corporate tunnel)
# socks5:// is rewritten to socks5h:// by the launcher so DNS resolves inside
# the tunnel, which is what private hostnames need.
ATLASSIAN_SOCKS_PROXY=socks5://localhost:9999

# Boundary 3: never let the agent see spaces/projects it has no business in.
CONFLUENCE_SPACES_FILTER=DEV,ARCH
JIRA_PROJECTS_FILTER=PROJ,OPS

# Internal CA not in the system store? Prefer adding the CA over disabling this.
# CONFLUENCE_SSL_VERIFY=true
# JIRA_SSL_VERIFY=true

# Pin the server build (supply chain + reproducibility). Empty = latest.
# MCP_ATLASSIAN_VERSION=
# ATLASSIAN_MCP_RUNTIME=uvx   # or: podman
