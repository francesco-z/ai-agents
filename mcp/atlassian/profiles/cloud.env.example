# Atlassian Cloud, via the same self-hosted server as on-prem — use this when
# you want ONE identical toolset across all customers. If you would rather use
# Atlassian's official Rovo MCP server for this site, skip this profile and see
# clients/ + README (it is Cloud-only and cannot reach on-prem behind a VPN).
#
# Copy to ~/.config/atlassian-mcp/<client>.env and chmod 600.

CONFLUENCE_URL=https://acme.atlassian.net/wiki
JIRA_URL=https://acme.atlassian.net

# Cloud auth = account email + API token from id.atlassian.com.
# Create a SCOPED token and tick read scopes only (read:confluence-content.all,
# read:jira-work, ...); the account itself should also be a read-only user.
CONFLUENCE_USERNAME=you@example.com
CONFLUENCE_API_TOKEN=
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=

CONFLUENCE_SPACES_FILTER=DEV,ARCH
JIRA_PROJECTS_FILTER=PROJ,OPS

# No tunnel for Cloud; set ATLASSIAN_SOCKS_PROXY only if your egress requires it.
# MCP_ATLASSIAN_VERSION=
