# Command guardrails for Codex, mirroring permissions.deny / permissions.ask in
# .claude/settings.json. Installed to ~/.codex/rules/ by install.sh; keep the two
# in step. The strictest matching rule wins (forbidden > prompt > allow).
#
# Patterns are argument prefixes with no wildcards, so two Claude rules have no
# exact equivalent: `aws <service> <mutating-verb>-*` becomes a prompt on every
# aws call, and the `git clone` option denies fall under the clone prompt.
# Claude's allow list is not mirrored: an allow here would also lift the sandbox.

prefix_rule(
    pattern = ["aws", "s3", ["cp", "mb", "mv", "rb", "rm", "sync"]],
    decision = "forbidden",
    justification = "No real-environment mutations; S3 is read-only (aws s3 ls).",
)
prefix_rule(
    pattern = ["aws"],
    decision = "prompt",
    justification = "Read-only AWS calls only (describe/get/list); mutations are a manual gate.",
)

prefix_rule(
    pattern = ["eksctl", [
        "associate", "create", "delete", "disable", "disassociate", "drain",
        "enable", "scale", "set", "unset", "update", "upgrade", "utils",
    ]],
    decision = "forbidden",
    justification = "No real-environment mutations; eksctl get/info only.",
)

prefix_rule(
    pattern = ["gh", "pr", ["merge", "review"]],
    decision = "forbidden",
    justification = "Draft PRs only; merging and reviewing are for the human.",
)

prefix_rule(
    pattern = ["git", "-c"],
    decision = "forbidden",
    justification = "Inline git config can run arbitrary commands.",
)
prefix_rule(
    pattern = ["git", "push", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "No force pushes.",
)
prefix_rule(
    pattern = ["git", "push", "origin", ["main", "master", "HEAD:main", "HEAD:master"]],
    decision = "forbidden",
    justification = "Never push to main/master; push a feature branch and open a draft PR.",
)
prefix_rule(
    pattern = ["git", ["clone", "push"]],
    decision = "prompt",
    justification = "Cloning and pushing need approval.",
)

prefix_rule(
    pattern = ["helm", ["delete", "install", "push", "rollback", "uninstall", "upgrade"]],
    decision = "forbidden",
    justification = "No real-environment mutations; helm get/list/status/template only.",
)

prefix_rule(
    pattern = ["kubectl", [
        "annotate", "apply", "attach", "autoscale", "certificate", "cordon", "cp",
        "create", "debug", "delete", "drain", "edit", "exec", "expose", "label",
        "patch", "port-forward", "proxy", "replace", "run", "scale", "set", "taint",
        "uncordon",
    ]],
    decision = "forbidden",
    justification = "No real-environment mutations; kubectl get/describe/logs/top only.",
)
prefix_rule(
    pattern = ["kubectl", "rollout", ["pause", "restart", "resume", "undo"]],
    decision = "forbidden",
    justification = "No real-environment mutations.",
)

prefix_rule(
    pattern = [["terraform", "tofu"], ["apply", "destroy", "force-unlock", "import"]],
    decision = "forbidden",
    justification = "No real-environment mutations; plan/validate only.",
)
prefix_rule(
    pattern = [["terraform", "tofu"], "state", ["mv", "rm"]],
    decision = "forbidden",
    justification = "State surgery is a manual gate.",
)

# Anything that fetches and runs or installs third-party code.
prefix_rule(
    pattern = ["go", ["get", "install"]],
    decision = "prompt",
    justification = "Installs third-party code.",
)
prefix_rule(
    pattern = ["npm", ["exec", "i", "install", "publish"]],
    decision = "prompt",
    justification = "Installs, runs or publishes packages.",
)
prefix_rule(
    pattern = ["npx"],
    decision = "prompt",
    justification = "Runs a package that may be downloaded on the spot.",
)
prefix_rule(
    pattern = [["pip", "pip3"], "install"],
    decision = "prompt",
    justification = "Installs third-party code.",
)
prefix_rule(
    pattern = [["pnpm", "yarn"], ["add", "dlx"]],
    decision = "prompt",
    justification = "Installs or runs third-party code.",
)
prefix_rule(
    pattern = ["uv", ["add", "tool"]],
    decision = "prompt",
    justification = "Installs or runs third-party code.",
)
prefix_rule(
    pattern = ["uv", "pip", "install"],
    decision = "prompt",
    justification = "Installs third-party code.",
)
